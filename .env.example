# DNS API tokens (only need the one for your provider)
# Cloudflare: Zone Read + DNS Edit permissions
CF_API_TOKEN=
# Hetzner: DNS API token
# HETZNER_API_TOKEN=

# Required: Email for SSL certificate notifications
EMAIL=

# Optional: Caddy log level (DEBUG, INFO, WARN, ERROR, default: ERROR)
# LOG_LEVEL=ERROR

# Optional: Status page domain (enables watcher dashboard)
# CADDY_DOMAIN=status.example.com
# CADDY_ALLOWLIST=myhost.dyndns.org,1.2.3.4
# CADDY_TRUSTED_PROXIES=192.168.1.10,my-proxy.example.com
# CADDY_AUTH=true
# CADDY_AUTH_URL=https://login.example.com   (nur https, kein Klartext)
# CADDY_AUTH_PATHS=/admin,/admin/*

# Optional: Wartezeit vor dem Aufraeumen verwaister Configs (Default 30m).
# Hochsetzen, wenn Updates laenger dauern - z. B. bei vielen Containern oder
# verketteten Abhaengigkeiten.
# CONFIG_CLEANUP_GRACE=30m

# Optional: Wildcard certificates (comma-separated, keeps subdomains private)
# WILDCARD_DOMAINS=example.com,other.com
# WILDCARD_DNS_PROVIDER=cloudflare

# TinyAuth (optional, use with docker-compose.auth.yml)
# TINYAUTH_APP_URL=https://auth.example.com
# TINYAUTH_DOMAIN=auth.example.com
# Nur setzen, wenn der Cookie-Scope nicht die Parent-Domain von TINYAUTH_DOMAIN
# ist (im Browser unter Set-Cookie -> Domain nachsehen)
# TINYAUTH_COOKIE_DOMAIN=.example.com
# TINYAUTH_TYPE=external
# TINYAUTH_APP_TITLE=My Login
# TINYAUTH_BACKGROUND_IMAGE=https://example.com/bg.jpg
# Trust proxies in front of Caddy when Caddy exposes the TinyAuth UI
# TINYAUTH_TRUSTED_PROXIES=192.168.1.10,other-caddy.example.com
# PocketID OIDC provider
# OIDC_PROVIDER_URL=https://pocketid.example.com
# OIDC_CLIENT_ID=your-pocketid-client-id
# OIDC_CLIENT_SECRET=your-pocketid-client-secret
